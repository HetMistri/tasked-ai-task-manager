# Tasked: AI Enabled Task Manager - Environment Configuration
# Copy this file to .env and fill in your values

# Application Environment
APP_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://tasked:tasked@postgres:5432/tasked

# Authentication
JWT_SECRET=replace-with-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google Gemini (AI Service)
# Keep GEMINI_ENABLED=false to run the clearly-labelled mock provider.
# Set GEMINI_ENABLED=true and provide a key to use the real Gemini API.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# Frontend
FRONTEND_ORIGIN=http://localhost:5173

# AI Service (internal)
TASK_API_URL=http://task-service:8000
TASK_API_TIMEOUT=10.0
